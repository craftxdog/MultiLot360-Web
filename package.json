{
  "name": "multilot-360-web",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "browserslist": "4.29.3",
    "brace-expansion": "1.1.21",
    "nanoid": "3.3.18",
    "postcss": "8.5.30",
    "socket.io-parser": "4.2.7",
    "source-map-js": "1.2.2",
    "js-yaml": "4.3.2"
  },
  "scripts": {
    "dev:web": "cd apps/web && bun run dev",
    "dev:desktop": "cd apps/desktop && bun run dev",
    "build:web": "cd apps/web && bun run build",
    "build:desktop": "cd apps/desktop && bun run build",
    "lint:web": "cd apps/web && bun run lint",
    "typecheck:web": "cd apps/web && bun run typecheck",
    "test:api-client": "bun test packages/api-client/src",
    "test:web": "cd apps/web && bun run test",
    "test:e2e:web": "cd apps/web && bun run test:e2e",
    "test:desktop": "cd apps/desktop && bun run test",
    "format:check:desktop": "cargo fmt --manifest-path apps/desktop/src-tauri/Cargo.toml -- --check",
    "check:web": "bun run lint:web && bun run typecheck:web && bun run test:web && bun run build:web",
    "check:desktop": "bun run test:desktop && bun run build:desktop",
    "check:frontend": "bun run lint:web && bun run typecheck:web && bun run test:api-client && bun run test:web && bun run test:desktop && bun run format:check:desktop && bun run build:web"
  }
}
